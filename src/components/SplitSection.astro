---
import { sitePath } from "../lib/site-path.js";
---

<section class="section split-section">
  <div class="split-text">
    <p class="kicker">Who We Are</p>
    <h2>An international community of scholars and students</h2>
    <p>
      Founded in 1953, the Society for Ancient Greek Philosophy supports rigorous inquiry,
      conversation across traditions, and the continuing study of Ancient Greek philosophy.
    </p>
    <p>
      The Society especially encourages junior and mid-career scholars and seeks to sustain
      a welcoming, diverse, and intellectually generous community.
    </p>
    <p><a href={sitePath("/who-we-are/")}>Read more about the Society</a></p>
  </div>

  <figure class="split-image">
    <img src={sitePath("/assets/images/delphi_treasury.jpg")} alt="Temple of Apollo at Delphi" />
  </figure>
</section>
