---
import PageHero from "../../components/PageHero.astro";
import SAGPLayout from "../../layouts/SAGPLayout.astro";
---

<SAGPLayout title="Membership | Society for Ancient Greek Philosophy">

<PageHero
  kicker="Membership"
  title="Join a worldwide conversation about Ancient Greek philosophy."
  subtitle="SAGP membership is open to scholars and students of Ancient Greek philosophy and supports the Society’s conferences, lectures, mentoring, and international scholarly community."
  image="/assets/images/delphi_treasury.jpg"
/>

<section class="section two-col">
  <div><h2>Membership and dues</h2></div>
  <div>
    <p>Annual SAGP dues are <strong>$20 per year</strong>. Presenters and attendees
      at SAGP events must be paid-up members in good standing.</p>
    <div class="callout">
      SAGP is transitioning to a new dues payment system through the
      Philosophy Documentation Center (PDC). Updated payment instructions
      will be posted here when the system is ready. Please do not use the
      previous membership form or payment methods.
    </div>
    <p>For membership questions, please contact{" "}
      <a href="mailto:SAGPcontact@gmail.com">SAGPcontact@gmail.com</a>.</p>
  </div>
</section>

</SAGPLayout>
